{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coverwin",
  "version": "1.0.0",
  "identifier": "com.coverwin.app",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "coverwin",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "center": true,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/coverwin-cli"
    ],
    "resources": {
      "../../scripts/install-menu.ps1": "install-menu.ps1",
      "../../scripts/uninstall-menu.ps1": "uninstall-menu.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "installerHooks": "installer.nsh"
      }
    }
  }
}
